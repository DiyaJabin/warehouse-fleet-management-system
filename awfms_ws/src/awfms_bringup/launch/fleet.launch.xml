<launch>

    <!-- Start Gazebo with the warehouse world -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(find-pkg-share awfms_bringup)/worlds/warehouse.sdf"/>
    </include>

    <!-- Spawn robot_1 in Gazebo -->
    <node pkg="ros_gz_sim" exec="create" name="spawn_robot_1">
        <param name="name" value="robot_1"/>
        <param name="file" value="$(find-pkg-share awfms_bringup)/models/robot_1/model.sdf"/>
        <param name="x" value="0.0"/>
        <param name="y" value="0.0"/>
        <param name="z" value="0.2"/>
    </node>

    <!-- Publish static transform from robot_1 base to LiDAR -->
    <node pkg="tf2_ros" exec="static_transform_publisher" name="robot_1_lidar_tf" args="0 0 0.15 0 0 0 robot_1/base_link robot_1/base_link/lidar"/>

    <!-- Spawn robot_2 in Gazebo -->
    <node pkg="ros_gz_sim" exec="create" name="spawn_robot_2">
        <param name="name" value="robot_2"/>
        <param name="file" value="$(find-pkg-share awfms_bringup)/models/robot_2/model.sdf"/>
        <param name="x" value="2.0"/>
        <param name="y" value="0.0"/>
        <param name="z" value="0.2"/>
    </node>

    <!-- Static transform for robot_2 LiDAR -->
    <node pkg="tf2_ros" exec="static_transform_publisher" name="robot_2_lidar_tf" args="0 0 0.15 0 0 0 robot_2/base_link robot_2/base_link/lidar"/>

    <!-- Spawn robot_3 in Gazebo -->
    <node pkg="ros_gz_sim" exec="create" name="spawn_robot_3">
        <param name="name" value="robot_3"/>
        <param name="file" value="$(find-pkg-share awfms_bringup)/models/robot_3/model.sdf"/>
        <param name="x" value="-2.0"/>
        <param name="y" value="0.0"/>
        <param name="z" value="0.2"/>
    </node>

    <node pkg="tf2_ros" exec="static_transform_publisher" name="robot_3_lidar_tf" args="0 0 0.15 0 0 0 robot_3/base_link robot_3/base_link/lidar"/>


    <!-- Spawn robot_4 in Gazebo -->
    <node pkg="ros_gz_sim" exec="create" name="spawn_robot_4">
        <param name="name" value="robot_4"/>
        <param name="file" value="$(find-pkg-share awfms_bringup)/models/robot_4/model.sdf"/>
        <param name="x" value="4.0"/>
        <param name="y" value="0.0"/>
        <param name="z" value="0.2"/>
    </node>

    <!-- Static transform for robot_4 LiDAR -->
    <node pkg="tf2_ros" exec="static_transform_publisher" name="robot_4_lidar_tf" args="0 0 0.15 0 0 0 robot_4/base_link robot_4/base_link/lidar"/>
    <!-- Start the Gazebo-ROS 2 bridge -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="gz_bridge">
        <param name="config_file" value="$(find-pkg-share awfms_bringup)/config/bridge.yaml"/>
    </node>
    <!-- Start SLAM Toolbox for robot_1 -->
    <node pkg="slam_toolbox" exec="async_slam_toolbox_node" name="slam_toolbox" output="screen">

        <param from="$(find-pkg-share awfms_bringup)/config/slam_toolbox.yaml"/>

        <param name="use_sim_time" value="true"/>

    </node>

    <!-- Start Fleet Manager -->
    <node pkg="awfms_fleet_manager" exec="fleet_manager" name="fleet_manager"/>

    <!-- Start robot_1 ROS node -->
    <node pkg="awfms_fleet_manager" exec="robot_node" name="robot_1" namespace="/robot_1">
        <param from="$(find-pkg-share awfms_bringup)/config/robots.yaml"/>
    </node>

    <!-- Start robot_2 ROS node -->
    <node pkg="awfms_fleet_manager" exec="robot_node" name="robot_2" namespace="/robot_2">
        <param from="$(find-pkg-share awfms_bringup)/config/robots.yaml"/>
    </node>
    <!-- Start robot_3 ROS node -->
    <node pkg="awfms_fleet_manager" exec="robot_node" name="robot_3" namespace="/robot_3">
        <param from="$(find-pkg-share awfms_bringup)/config/robots.yaml"/>
    </node>
    <!-- Start robot_4 ROS node -->
    <node pkg="awfms_fleet_manager" exec="robot_node" name="robot_4" namespace="/robot_4">
        <param from="$(find-pkg-share awfms_bringup)/config/robots.yaml"/>
    </node>

</launch>