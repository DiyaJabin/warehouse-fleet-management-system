<?xml version="1.0"?>

<sdf version="1.10">

    <model name="robot_1">

        <static>false</static>

        <!-- Main robot chassis -->
        <link name="base_link">

            <visual name="base_visual">
                <geometry>
                    <box>
                        <size>0.8 0.6 0.2</size>
                    </box>
                </geometry>
            </visual>

            <collision name="base_collision">
                <geometry>
                    <box>
                        <size>0.8 0.6 0.2</size>
                    </box>
                </geometry>
            </collision>

            <inertial>
                <mass>10.0</mass>
                <inertia>
                    <ixx>0.61</ixx>
                    <iyy>0.56</iyy>
                    <izz>1.13</izz>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyz>0.0</iyz>
                </inertia>
            </inertial>
            <!-- 2D LiDAR sensor -->
            <sensor name="lidar" type="gpu_lidar">
                <pose>0 0 0.15 0 0 0</pose>
                <topic>/robot_1/scan</topic>
                <update_rate>10</update_rate>

                <lidar>
                    <scan>
                        <horizontal>
                            <samples>360</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.14159</min_angle>
                            <max_angle>3.14159</max_angle>
                        </horizontal>
                    </scan>

                    <range>
                        <min>0.12</min>
                        <max>10.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </lidar>

                <always_on>true</always_on>
                <visualize>true</visualize>
            </sensor>


        </link>


        <!-- Left driven wheel -->
        <link name="left_wheel">

            <pose>0 0.34 -0.05 0 0 0</pose>

            <visual name="left_wheel_visual">
                <geometry>
                    <cylinder>
                        <radius>0.15</radius>
                        <length>0.08</length>
                    </cylinder>
                </geometry>

                <!-- Rotate cylinder so axle points along Y -->
                <pose>0 0 0 1.5708 0 0</pose>
            </visual>

            <collision name="left_wheel_collision">
                <geometry>
                    <cylinder>
                        <radius>0.15</radius>
                        <length>0.08</length>
                    </cylinder>
                </geometry>

                <pose>0 0 0 1.5708 0 0</pose>
            </collision>

            <inertial>
                <mass>1.0</mass>
                <inertia>
                    <ixx>0.0069</ixx>
                    <iyy>0.0069</iyy>
                    <izz>0.01125</izz>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyz>0.0</iyz>
                </inertia>
            </inertial>

        </link>


        <!-- Right driven wheel -->
        <link name="right_wheel">

            <pose>0 -0.34 -0.05 0 0 0</pose>

            <visual name="right_wheel_visual">
                <geometry>
                    <cylinder>
                        <radius>0.15</radius>
                        <length>0.08</length>
                    </cylinder>
                </geometry>

                <!-- Rotate cylinder so axle points along Y -->
                <pose>0 0 0 1.5708 0 0</pose>
            </visual>

            <collision name="right_wheel_collision">
                <geometry>
                    <cylinder>
                        <radius>0.15</radius>
                        <length>0.08</length>
                    </cylinder>
                </geometry>

                <pose>0 0 0 1.5708 0 0</pose>
            </collision>

            <inertial>
                <mass>1.0</mass>
                <inertia>
                    <ixx>0.0069</ixx>
                    <iyy>0.0069</iyy>
                    <izz>0.01125</izz>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyz>0.0</iyz>
                </inertia>
            </inertial>

        </link>


        <!-- Front caster -->
        <link name="caster">

            <pose>0.28 0 -0.12 0 0 0</pose>

            <visual name="caster_visual">
                <geometry>
                    <sphere>
                        <radius>0.08</radius>
                    </sphere>
                </geometry>
            </visual>

            <collision name="caster_collision">
                <geometry>
                    <sphere>
                        <radius>0.08</radius>
                    </sphere>
                </geometry>
            </collision>

            <inertial>
                <mass>0.5</mass>
                <inertia>
                    <ixx>0.00128</ixx>
                    <iyy>0.00128</iyy>
                    <izz>0.00128</izz>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyz>0.0</iyz>
                </inertia>
            </inertial>

        </link>


        <!-- Left wheel joint -->
        <joint name="left_wheel_joint" type="revolute">

            <parent>base_link</parent>
            <child>left_wheel</child>

            <axis>
                <xyz>0 1 0</xyz>
            </axis>

        </joint>


        <!-- Right wheel joint -->
        <joint name="right_wheel_joint" type="revolute">

            <parent>base_link</parent>
            <child>right_wheel</child>

            <axis>
                <xyz>0 1 0</xyz>
            </axis>

        </joint>


        <!-- Caster joint -->
        <joint name="caster_joint" type="ball">

            <parent>base_link</parent>
            <child>caster</child>

        </joint>


        <!-- Differential drive system -->
        <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">

            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <wheel_separation>0.68</wheel_separation>
            <wheel_radius>0.15</wheel_radius>

            <topic>/robot_1/cmd_vel</topic>

            <odom_topic>/robot_1/odom</odom_topic>
            <tf_topic>/tf</tf_topic>

            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>

        </plugin>

    </model>

</sdf>