<?xml version="1.0" ?>

<sdf version="1.10">

  <world name="warehouse">

    <!-- ================================================= -->
    <!-- GAZEBO SYSTEM PLUGINS                             -->
    <!-- ================================================= -->

    <!-- Physics system -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>

    <!-- Scene broadcaster -->
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- User commands / entity spawning -->
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Sensors system -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>


    <!-- ================================================= -->
    <!-- PHYSICS                                           -->
    <!-- ================================================= -->

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- ================================================= -->
    <!-- SCENE / LIGHTING                                  -->
    <!-- ================================================= -->

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.6 0.6 0.6 1</background>
      <shadows>true</shadows>
    </scene>


    <!-- ================================================= -->
    <!-- GROUND                                            -->
    <!-- ================================================= -->

    <model name="ground">

      <static>true</static>

      <link name="link">

        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ================================================= -->
    <!-- SHELVES                                           -->
    <!-- Two rows of three shelves                         -->
    <!-- ================================================= -->

    <!-- SHELF 1 -->
    <model name="shelf_1">

      <static>true</static>
      <pose>-4 2 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- SHELF 2 -->
    <model name="shelf_2">

      <static>true</static>
      <pose>0 2 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- SHELF 3 -->
    <model name="shelf_3">

      <static>true</static>
      <pose>4 2 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- SHELF 4 -->
    <model name="shelf_4">

      <static>true</static>
      <pose>-4 -2 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- SHELF 5 -->
    <model name="shelf_5">

      <static>true</static>
      <pose>0 -2 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- SHELF 6 -->
    <model name="shelf_6">

      <static>true</static>
      <pose>4 -2 1 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>2 0.8 2</size>
            </box>
          </geometry>

          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ================================================= -->
    <!-- LIGHT                                             -->
    <!-- ================================================= -->

    <light name="sun" type="directional">

      <pose>0 0 10 0 0 0</pose>

      <cast_shadows>true</cast_shadows>

      <diffuse>1 1 1 1</diffuse>

      <specular>0.3 0.3 0.3 1</specular>

      <direction>-0.5 0.5 -1</direction>

    </light>

  </world>

</sdf>